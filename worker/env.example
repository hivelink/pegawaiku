# Salin menjadi worker/.env (file .env tidak ikut ke Git) lalu isi.

# Supabase project yang sama dengan aplikasi PegawaiKu (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Kunci service_role: RAHASIA. Hanya untuk pekerja ini; jangan pernah ditaruh di browser atau dibagikan.
SUPABASE_SERVICE_ROLE_KEY=

# ID organisasi Anda (lihat halaman Asisten → "Menyiapkan pekerja"). Membatasi pekerja ke organisasi ini saja.
AUTOPILOT_ORG_ID=

# Nama pekerja yang tampil di aplikasi
AUTOPILOT_WORKER_NAME=nas-rumah

# Opsional: kunci Claude bila tidak diisi di Pengaturan → Kunci API (pemakaiannya memotong kredit PegawaiKu)
# ANTHROPIC_API_KEY=
# Opsional: paksa model tertentu untuk mode otonom, format provider/model
# AUTOPILOT_MODEL=anthropic/claude-sonnet-5-5
# Opsional: seberapa sering memeriksa antrean (detik, default 10)
# AUTOPILOT_POLL_SECONDS=10
# Opsional: project tujuan untuk misi dari Telegram (/misi …). Kosong = project pertama.
# AUTOPILOT_PROJECT_ID=
# Opsional: matikan backup otomatis router sebelum perubahan (TIDAK disarankan)
# AUTOPILOT_ROUTER_BACKUP=off
# Opsional: jarak pemantauan perangkat jaringan (detik, minimal 20, default 60)
# NETWORK_MONITOR_SECONDS=60
